# PostgreSQL connection string — local Docker (see 00-prereqs.md step 3)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cityops"

# Auth.js (NextAuth v5) — required
# Generate with: openssl rand -base64 32  (must be at least 32 random characters)
# NEVER commit the real value to source control
AUTH_SECRET="your-secret-here-min-32-chars"

# Canonical base URL of the application — used for OAuth redirect URL construction
NEXTAUTH_URL="http://localhost:3000"

# File storage provider: "local" (default) writes to public/uploads/ on disk.
# Set to "azure" for production and provide the variables below.
STORAGE_PROVIDER="local"

# Azure Blob Storage — required when STORAGE_PROVIDER=azure
# AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
# AZURE_STORAGE_CONTAINER="cityops-uploads"

# Email — Mailpit (local SMTP capture, UI at http://localhost:8025)
# docker run -d --name mailpit -p 8025:8025 -p 1025:1025 axllent/mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
# EMAIL_FROM="CityOps <noreply@cityops.dev>"

# Azure OpenAI — required for AI report validation (F-75)
# Provision a resource at https://portal.azure.com and deploy a vision-capable model (e.g. gpt-4o)
AZURE_OPENAI_ENDPOINT="https://<resource-name>.openai.azure.com"
AZURE_OPENAI_API_KEY="<your-azure-openai-api-key>"
AZURE_OPENAI_DEPLOYMENT="gpt-4o"
# API version — default used if unset: 2024-02-01
# AZURE_OPENAI_API_VERSION="2024-02-01"
# Model version label stored on AiValidationResult for audit purposes
# AI_MODEL_VERSION="v1"
