{
  "name": "cityops",
  "version": "0.1.0",
  "private": false,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "workshop:build": "npm --prefix workshop run build",
    "start": "next start",
    "lint": "eslint",
    "lint:report": "eslint --format junit --output-file reports/lint-results.xml",
    "lint:sarif": "eslint --format @microsoft/eslint-formatter-sarif --output-file reports/sarif/eslint.sarif",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/__tests__/unit",
    "test:integration": "vitest run src/__tests__/integration",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:ui": "playwright test --project=firefox --project=webkit --project=mobile-chrome --project=a11y --project=visual",
    "test:coverage": "vitest run --coverage",
    "test:load": "k6 run performance-tests/load-test.js",
    "check:duplication": "jscpd src --threshold 5 --reporters console,html --output reports/jscpd",
    "check:bundle-size": "size-limit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:reset": "prisma migrate reset",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/monitor-opentelemetry": "^1.19.0",
    "@azure/storage-blob": "^12.33.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7",
    "@prisma/client": "^7",
    "@prisma/instrumentation": "^7.9.1",
    "@types/leaflet.markercluster": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.0",
    "openai": "^6.33.0",
    "pg": "^8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.0",
    "react-icons": "^5.6.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-markercluster": "^5.0.0-rc.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@playwright/test": "^1.62.1",
    "@size-limit/file": "^13.0.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-formatter-junit": "^9.0.1",
    "jscpd": "^5.0.15",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "prisma": "^7",
    "size-limit": "^13.0.3",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "nodemailer": "$nodemailer",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.5",
    "eslint-plugin-react-hooks": "7.0.1"
  },
  "size-limit": [
    {
      "name": "Client JS bundle (.next/static/chunks)",
      "path": ".next/static/chunks/**/*.js",
      "limit": "800 kB"
    }
  ]
}
